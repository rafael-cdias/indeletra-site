---
import '../styles/global.css';
import site from '../data/site.json';
import { getCollection } from 'astro:content';

interface Props { title?: string; description?: string; image?: string; }
const { title, description = site.descricao_seo, image = site.logo } = Astro.props;
const fullTitle = title ? `${title} – ${site.nome}` : `${site.nome} – ${site.slogan}`;
const produtos = (await getCollection('produtos')).sort((a, b) => a.data.ordem - b.data.ordem);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsapp_mensagem)}`;
const ano = new Date().getFullYear();
const sociais = [
  { nome: 'Instagram', url: site.instagram },
  { nome: 'Facebook', url: site.facebook },
  { nome: 'YouTube', url: site.youtube },
].filter((s) => s.url);
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="icon" href={site.icone} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta property="og:locale" content="pt_BR" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Sora:wght@500;600;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Organization', name: site.razao_social, url: Astro.site?.toString(),
    logo: new URL(site.logo, Astro.site).toString(), telephone: site.telefone_link, email: site.email_contato,
    foundingDate: '1985-11-26',
    address: { '@type': 'PostalAddress', streetAddress: site.endereco, addressLocality: 'Brasília', addressRegion: 'DF', postalCode: '73020-411', addressCountry: 'BR' },
    sameAs: sociais.map((s) => s.url),
  })} />
</head>
<body>
  <div class="topbar">
    <div class="container">
      <div class="info">
        <a href={`tel:${site.telefone_link}`}>{site.telefone}</a>
        <a class="email" href={`mailto:${site.email_contato}`}>{site.email_contato}</a>
        <span class="horario">{site.horario}</span>
      </div>
      <div class="sociais">
        {sociais.map((s) => <a href={s.url} target="_blank" rel="noopener">{s.nome}</a>)}
      </div>
    </div>
  </div>

  <header class="cabecalho">
    <div class="container">
      <a class="marca" href="/" aria-label={`${site.nome} – início`}><img src={site.logo} alt={site.nome} width="160" height="46" /></a>
      <button class="menu-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="nav"><span></span><span></span><span></span></button>
      <nav class="nav" id="nav">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Início</a>
        <div class="grupo">
          <button type="button">Produtos <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" stroke="currentColor" stroke-width="1.6" fill="none"/></svg></button>
          <div class="submenu">
            {produtos.map((p) => <a href={`/${p.id}/`} aria-current={path === `/${p.id}` ? 'page' : undefined}>{p.data.menu || p.data.title}</a>)}
          </div>
        </div>
        <a href="/#catalogos">Catálogos</a>
        <a href="/#revenda">Seja revenda</a>
        <a href="/contato/" aria-current={path === '/contato' ? 'page' : undefined}>Contato</a>
        <a class="btn btn-primario" href={wa} target="_blank" rel="noopener" style="margin-left:8px">Orçamento</a>
      </nav>
    </div>
  </header>

  <main id="conteudo"><slot /></main>

  <footer class="rodape">
    <div class="container">
      <div class="grid">
        <div>
          <a class="logo-rodape" href="/"><img src={site.logo} alt={site.nome} /></a>
          <p>{site.endereco}<br />{site.cidade}</p>
          <p>{site.horario}</p>
        </div>
        <div>
          <h4>Produtos</h4>
          <ul>{produtos.map((p) => <li><a href={`/${p.id}/`}>{p.data.menu || p.data.title}</a></li>)}</ul>
        </div>
        <div>
          <h4>Fale com a gente</h4>
          <p><a href={`tel:${site.telefone_link}`}>{site.telefone}</a><br />
            <a href={`mailto:${site.email_vendas}`}>{site.email_vendas}</a><br />
            <a href={`mailto:${site.email_suporte}`}>{site.email_suporte}</a></p>
          <div class="sociais" style="margin-top:12px">
            {sociais.map((s) => <a href={s.url} target="_blank" rel="noopener">{s.nome}</a>)}
          </div>
        </div>
      </div>
      <div class="copy">© {ano} Todos os direitos reservados. {site.razao_social}.</div>
    </div>
  </footer>

  <a class="whatsapp" href={wa} target="_blank" rel="noopener" aria-label="Conversar pelo WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.5 2 2 6.1 2 11.2c0 2.6 1.2 5 3.1 6.7L4 22l4.4-2.1c1.1.4 2.3.5 3.6.5 5.5 0 10-4.1 10-9.2S17.5 2 12 2zm-4 10.3a1.3 1.3 0 110-2.6 1.3 1.3 0 010 2.6zm4 0a1.3 1.3 0 110-2.6 1.3 1.3 0 010 2.6zm4 0a1.3 1.3 0 110-2.6 1.3 1.3 0 010 2.6z"/></svg>
  </a>

  <div class="lightbox" id="lightbox" hidden>
    <button class="lightbox-fechar" type="button" aria-label="Fechar">✕</button>
    <button class="lightbox-seta lightbox-anterior" type="button" aria-label="Foto anterior">‹</button>
    <img class="lightbox-img" alt="" />
    <button class="lightbox-seta lightbox-proxima" type="button" aria-label="Próxima foto">›</button>
    <div class="lightbox-contador"></div>
  </div>

  <script>
    // Pop-up (lightbox) das galerias de fotos de cada linha de produto
    const lb = document.getElementById('lightbox');
    if (lb) {
      const img = lb.querySelector('.lightbox-img');
      const contador = lb.querySelector('.lightbox-contador');
      let grupo = [];
      let idx = 0;

      const mostrar = () => {
        const atual = grupo[idx];
        const src = atual.getAttribute('data-lightbox-src');
        img.setAttribute('src', src || '');
        img.setAttribute('alt', atual.querySelector('img')?.getAttribute('alt') || '');
        contador.textContent = grupo.length > 1 ? `${idx + 1} / ${grupo.length}` : '';
      };
      const abrir = (grupoEl, i) => {
        grupo = [...grupoEl.querySelectorAll('[data-lightbox-src]')];
        idx = i;
        mostrar();
        lb.hidden = false;
        document.body.style.overflow = 'hidden';
      };
      const fechar = () => {
        lb.hidden = true;
        img.removeAttribute('src');
        document.body.style.overflow = '';
      };
      const navegar = (d) => {
        if (!grupo.length) return;
        idx = (idx + d + grupo.length) % grupo.length;
        mostrar();
      };

      document.querySelectorAll('.galeria').forEach((grupoEl) => {
        [...grupoEl.querySelectorAll('[data-lightbox-src]')].forEach((btn, i) => {
          btn.addEventListener('click', () => abrir(grupoEl, i));
        });
      });

      lb.querySelector('.lightbox-fechar')?.addEventListener('click', fechar);
      lb.querySelector('.lightbox-anterior')?.addEventListener('click', () => navegar(-1));
      lb.querySelector('.lightbox-proxima')?.addEventListener('click', () => navegar(1));
      lb.addEventListener('click', (e) => { if (e.target === lb) fechar(); });
      document.addEventListener('keydown', (e) => {
        if (lb.hidden) return;
        if (e.key === 'Escape') fechar();
        if (e.key === 'ArrowLeft') navegar(-1);
        if (e.key === 'ArrowRight') navegar(1);
      });
    }
  </script>

  <script>
    const btn = document.querySelector('.menu-toggle');
    const nav = document.getElementById('nav');
    btn?.addEventListener('click', () => {
      const aberto = nav?.classList.toggle('aberto');
      btn.setAttribute('aria-expanded', String(!!aberto));
    });
    nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => nav.classList.remove('aberto')));
  </script>
</body>
</html>
